# ============================================================
#  D&D AI Master — настройки окружения
#  Скопируйте этот файл в .env и заполните обязательные пункты.
#  Быстрый путь: ./install.sh — он сделает всё сам.
# ============================================================

# ---------- ОБЯЗАТЕЛЬНО ----------

# Порт, на котором откроется игра (проброс из контейнера)
APP_PORT=8000

# Ключ провайдера. Подходит любой OpenAI-совместимый API:
# OpenAI, OpenRouter, DeepSeek, Together, Ollama, LM Studio, vLLM и т.д.
LLM_API_KEY=your-api-key-here

# Адрес API вашего провайдера (оканчивается на /v1).
# Примеры:
#   OpenAI          https://api.openai.com/v1
#   OpenRouter      https://openrouter.ai/api/v1
#   DeepSeek        https://api.deepseek.com/v1
#   Ollama локально http://host.docker.internal:11434/v1
LLM_API_BASE_URL=https://api.deepseek.com/v1

# Название модели у вашего провайдера.
# Примеры: gpt-4o-mini, deepseek-chat, qwen2.5:14b, llama3.1:8b
MODEL=deepseek-chat

# Секрет для подписи JWT-токенов, минимум 32 символа.
# Сгенерировать: openssl rand -hex 32
# install.sh делает это автоматически.
JWT_SECRET=

# ---------- ОСНОВНОЕ ----------

# Сколько последних сообщений держать в контексте модели
MAX_HISTORY_LENGTH=20

# Таймаут ожидания ответа модели, секунды
API_TIMEOUT=120

# Модель для перевода описания внешности персонажа в промпт картинки
APPEARANCE_PROMPT_MODEL=deepseek-chat

# ---------- ДОСТУП ----------

# Адреса, с которых разрешены запросы к API (JSON-массив в одну строку)
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]

# ID пользователей-администраторов через запятую. Пусто = админов нет.
# Свой ID виден в ответе /api/v1/auth/me после регистрации
ADMIN_USER_IDS=

# ---------- ДОСТУП К ИГРЕ ----------

# true — каждый запрос проверяет активацию и подписку (платный режим).
# false — доступ открыт всем зарегистрированным, регистрация сразу активна.
REQUIRE_ACCESS=false

# ---------- ОГРАНИЧЕНИЯ ----------

# Лимит запросов на пользователя
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=60

# Подробные логи и /docs (Swagger). Для продакшена ставьте false
DEBUG=false

# ---------- ПЛАТЕЖИ (необязательно) ----------

# ЮKassa. Оставьте пустым, если платежи не нужны — модуль отключится.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_TEST_MODE=true
YOOKASSA_RETURN_URL=http://localhost:8000/

# Boosty (синхронизация подписчиков). Необязательно.
BOOSTY_API_TOKEN=
BOOSTY_BLOG=
BOOSTY_URL=

# ---------- ПРОВАЙДЕР (необязательно) ----------

# Фильтр провайдеров у агрегаторов вроде OpenRouter: список через запятую.
# Пусто — провайдер выбирается автоматически.
PROVIDER_FILTER=

# ---------- ПОРТРЕТЫ ПЕРСОНАЖЕЙ (необязательно) ----------

# OpenAI-совместимый шлюз с image-моделью. Примеры: свой сервис на Ollama,
# OpenRouter, любой прокси с моделью генерации картинок.
# Пусто — портреты не генерируются, игра работает без картинок.
IMAGE_API_URL=

# Запасной путь (обычный /images/generations, ответ в b64_json).
IMAGE_API_ALT_URL=
IMAGE_API_ALT_KEY=
IMAGE_API_ALT_MODEL=gpt-image-1
